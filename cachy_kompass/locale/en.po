msgstr "Also show dependencies and libraries"

#: cachy_kompass/app.py:21
msgid "Zusätzlich nach Updates suchen (braucht Internet)"
msgstr "Also check for updates (needs internet)"

#: cachy_kompass/app.py:22
msgid "Gefundene Paketverwaltungen auflisten"
msgstr "List the package managers found"

#: cachy_kompass/app.py:23
msgid "Ausführliche Meldungen zur Fehlersuche"
msgstr "Detailed messages for troubleshooting"

#: cachy_kompass/app.py:27
msgid "Sprache der Oberfläche (Standard: Systemsprache)"
msgstr "Language of the interface (default: system language)"

#: cachy_kompass/app.py:60
msgid ""
"Die grafische Oberfläche braucht PySide6.\n"
"Installieren mit:  sudo pacman -S pyside6\n"
"(Fehler: {error})\n"
"Alternativ ohne Oberfläche:  cachy-kompass --cli"
msgstr ""
"The graphical interface needs PySide6.\n"
"Install it with:  sudo pacman -S pyside6\n"
"(Error: {error})\n"
"Without the window:  cachy-kompass --cli"

#: cachy_kompass/backup.py:42
