#: cachy_kompass/sources/pacman.py:176
msgid "Chaotic-AUR (nachträglich hinzugefügtes Zusatz-Repo mit fertig gebauten AUR-Paketen)"
msgstr "Chaotic-AUR (extra repo added later, with prebuilt AUR packages)"

#: cachy_kompass/sources/pacman.py:177
